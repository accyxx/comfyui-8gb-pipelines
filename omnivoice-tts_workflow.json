        252.3074187788743
      ],
      "flags": {},
      "order": 9,
      "mode": 0,
      "inputs": [],
      "outputs": [],
      "title": "Voice-Cloning the Master-Audio-File",
      "properties": {
        "ue_properties": {
          "widget_ue_connectable": {},
          "version": "7.8",
          "input_ue_unconnectable": {}
        }
      },
      "widgets_values": [
        "\"Now, pay close attention to the Voice Cloning phase, as this is where the real magic happens. Inject your master voice sample into the reference node and populate the text box with your target script. Crucially, you must audition the reference audio file first to guarantee absolute clarity and a completely clean signal. Remember, any minor background hiss or distortion will be amplified during the cloning pass, directly breaking the fidelity of your final vocal match.\""
      ],
      "color": "#223",
      "bgcolor": "#335"
