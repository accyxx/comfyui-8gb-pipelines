      "title": "Specialized Phoneme Trainer Sentence",
      "properties": {
        "ue_properties": {
          "widget_ue_connectable": {},
          "version": "7.8",
          "input_ue_unconnectable": {}
        }
      },
      "widgets_values": [
        "Are those shy phonologists trying to find every sound in each standard English sentence?\n\n\n(Generates a 5 to 6 seconds Audio-File for your Mastervoice and Voice-Cloning)\n\n"
      ],
      "color": "#223",
      "bgcolor": "#335"
    },
    {
      "id": 38,
      "type": "MarkdownNote",
      "pos": [
        320.53029402751775,
        2720.098349340969
